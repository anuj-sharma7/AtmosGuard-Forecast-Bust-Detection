IMD_API_KEY= 4ac4187cc0e4c2a70b1b850723a90410f4eb45daeb8ce018925d4dc13e38d34f

# How the key is sent. Leave empty, run `python -m app.ingest.imd_api --probe`,
# then set this to the scheme it reports, e.g. header-x-api-key or query-api_key.
IMD_API_AUTH=
